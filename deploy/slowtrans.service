[Unit]
Description=slowtrans - low-memory EPUB translator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/slowtrans
EnvironmentFile=/etc/slowtrans/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/slowtrans/venv/bin/slowtrans serve --host 127.0.0.1 --port 8790 --data /srv/slowtrans/data
Restart=on-failure
RestartSec=10

# 这台机器只有 1.7 GB，AstrBot 常驻约 690 MB。
# 321 MB 是硬上限：宁可任务被 OOM 杀掉重启，也不要拖垮同机的机器人。
MemoryHigh=280M
MemoryMax=320M
CPUQuota=80%
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# 最低权限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/slowtrans/data /srv/slowtrans/outputs

[Install]
WantedBy=multi-user.target
